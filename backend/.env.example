# backend/.env.example
# Copy this file to .env and fill in your credentials.
# The .env file is automatically loaded by llm_engine.py if python-dotenv is installed.

# ── LLM Configuration (optional) ──────────────────────────────────
# Tier-1: OpenAI GPT (fastest, best quality)
OPENAI_API_KEY=sk-your-openai-api-key-here
LLM_MODEL=gpt-3.5-turbo           # or gpt-4o-mini for better quality

# ── Data paths (override defaults if files are in non-standard locations) ──
# Path to the EEGNet pre-trained weights
MODEL_PATH=models/eegnet_p300.pt

# Path to s01.mat (reference dataset for ERP diagnostics + injector template)
# Defaults to: backend/data/s01.mat → ../data_explore/s01.mat (auto-detected)
# S01_MAT_PATH=C:/path/to/your/s01.mat
